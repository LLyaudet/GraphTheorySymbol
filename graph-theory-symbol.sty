\define@key{GTSxa}{relation}[true]{\def{\GTS@@relation}{1}}
\define@key{GTSxa}{rel}[true]{\def{\GTS@@relation}{1}}
\define@key{GTSxa}{r}[true]{\def{\GTS@@relation}{1}}

\newcommand{\GTSxa}[1][]{%
\def{\GTS@@mainColor}{}%
\def{\GTS@@secondColor}{}%
\def{\GTS@@drawSlash}{}%
\def{\GTS@@drawUpArrow}{}%
\def{\GTS@@drawDownArrow}{}%
\def{\GTS@@relation}{}%
\setkeys{GTSxa}{#1}%
\GTS@b{\GTS@@mainColor}{\GTS@@secondColor}{\GTS@@drawSlash}%
{\GTS@@drawUpArrow}{\GTS@@drawDownArrow}{\GTS@@relation}%
}

