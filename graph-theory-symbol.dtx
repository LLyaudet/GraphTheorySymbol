\newcommand{\usageExampleIII}[5]{
\tcbset{colback=white, colframe=black, on line, size=small}%
\tcbox{\texttt{A.\textbackslash{}#3/A.}}\newlineN
or \tcbox{\texttt{A.\textbackslash{}#4/A.}}\newlineN
or \tcbox{\texttt{A.\textbackslash{}#5/A.}}\newlineN
will yield \tcbox[colframe=blue]{A.\csname #5\endcsname/A.}.\newlineP
\tcbox{\texttt{#1 \textbackslash{}#3/ #2}}\newlineN
or \tcbox{\texttt{#1 \textbackslash{}#4/ #2}}\newlineN
or \tcbox{\texttt{#1 \textbackslash{}#5/ #2}}\newlineN
will yield \tcbox[colframe=blue]{#1 \csname #5\endcsname/ #2}.\newlineP
\tcbox{\texttt{\$#1 \textbackslash{}#3/ #2\$}}\newlineN
or \tcbox{\texttt{\$#1 \textbackslash{}#4/ #2\$}}\newlineN
or \tcbox{\texttt{\$#1 \textbackslash{}#5/ #2\$}}\newlineN
will yield \tcbox[colframe=blue]{$#1 \csname #5\endcsname/ #2$}.
}

