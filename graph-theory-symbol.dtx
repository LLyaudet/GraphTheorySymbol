\def\GTS@drawUpArrow{1}%
\GTSadjacencyMonochrome/%
\def\GTS@drawUpArrow{}%
}

\GTS@newcommand{\GTSdAUM}{\GTSdirectedAdjacencyUpMonochrome/}
