% \usageExampleAdjRelIII{GTSadjacencyRelation}{GTSadjRel}{GTSaR}
%
% \paragraph{\textbackslash{}GTSunadjacency,
% \textbackslash{}GTSunadj,
% \textbackslash{}GTSu}
%
% \DescribeMacro[noprint]{\GTSunadjacency}
