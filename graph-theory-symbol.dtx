\AddToHookNext{para/begin}{%
\expandafter\expandafter\expandafter\DescribeMacrocro%
\expandafter\expandafter\expandafter{%
\expandafter\csname \macroDescParagraphMacroI\endcsname}%
\if\macroDescParagraphMacroII\empty\else%
\expandafter\expandafter\expandafter\DescribeMacrocro%
\expandafter\expandafter\expandafter{%
\expandafter\csname \macroDescParagraphMacroII\endcsname}%
\fi%
\if\macroDescParagraphMacroIII\empty\else%
\expandafter\expandafter\expandafter\DescribeMacrocro%
\expandafter\expandafter\expandafter{%
\expandafter\csname \macroDescParagraphMacroIII\endcsname}%
\fi%
\if\macroDescParagraphMacroIV\empty\else%
\expandafter\expandafter\expandafter\DescribeMacrocro%
\expandafter\expandafter\expandafter{%
\expandafter\csname \macroDescParagraphMacroIV\endcsname}%
\fi%
}%
% \paragraph{^^A
% \textbackslash{}GTSadjacencyMonochromeRelation/,
% \textbackslash{}GTSadjMonoRel/,
% \textbackslash{}GTSadjMonRel/,
% \textbackslash{}GTSaMR/}\leavevmode\unskip\newlineN^^A
\paragraph{%
\textbackslash{}\macroDescParagraphMacroI\if#11/\fi%
\if\macroDescParagraphMacroII\empty\else%
,%
\if\macroDescParagraphMacroINewline 1%
\newlineN%
\else%
 %
\fi%
\textbackslash{}\macroDescParagraphMacroII\if#11/\fi%
\if\macroDescParagraphMacroIII\empty\else%
,%
\if\macroDescParagraphMacroIINewline 1%
\newlineN%
\else%
 %
\fi%
\textbackslash{}\macroDescParagraphMacroIII\if#11/\fi%
\if\macroDescParagraphMacroIV\empty\else%
,%
\if\macroDescParagraphMacroIIINewline 1%
\newlineN%
\else%
 %
\fi%
\textbackslash{}\macroDescParagraphMacroIV\if#11/\fi%
\fi%
\fi%
\fi%
}\leavevmode\unskip\newlineN%
% \label{macrodescgtsamr}^^A
% These macros will draw a monochrome adjacency symbol with relation
% spacing in math mode.\newlineP
% \usageExampleAdjRelIV{GTSadjacencyMonochromeRelation}{GTSadjMonoRel}^^A
% {GTSadjMonRel}{GTSaMR}\newlineP
% \linkToImpl{gtsamr}{1}
\label{macroDesc\macroDescParagraphShortest}%
#2\newlineP
\linkToImpl{\macroDescParagraphShortest}{\macroDescParagraphMany}
}


