% \subsection{Detailed usage}
%
% First you need to add in your preamble:
% |\usepackage{graph-theory-symbol}|.
%
% All symbols macros were designed with ease of use in mind:
% they are called with a trailing slash, they can be called in text mode or
% in math mode, a variant with relation spacing for math mode exists with
% suffix ``relation''.
%
% For completeness, we also documented macros with an at sign,
% but as usual, you should not (have to) use them directly.
%
% \subsubsection{General macros}
%
% \macroDescParagraph{GTS@newcommand}{0}^^A
% {}{0}^^A
% {}{0}^^A
% {}^^A
% {This macro will enforce that the other macros are called with a trailing
%  slash, avoiding problems with spaces after macro call.\newlineP
%  Arguments:\newlineN
%  \marg{commandname} The name of the command to create.\newlineN
%  \marg{commandcode} The code of the command to create.\newlineP
% }^^A
% {0}
%
% \paragraph{\textbackslash{}GTS@newprotectedcommand}
% \label{macrodescgtsnewprotectedcommand}
%
% \DescribeMacro[noprint]{\GTS@newprotectedcommand}\newlineN
% This macro will enforce that the other macros are called with a trailing
% slash, avoiding problems with spaces after macro call.\newlineP
% Arguments:\newlineN
% \marg{commandname} The name of the command to create.\newlineN
% \marg{commandcode} The code of the command to create.\newlineP
% \linkToImpl{gtsnewprotectedcommand}{0}
%
% \paragraph{\textbackslash{}GTSsetMainColor}
% \label{macrodescgtssetmaincolor}
%
% \DescribeMacro[noprint]{\GTSsetMainColor}\newlineN
% This macro will set the main color used in GraphTheorySymbol.
% This color has initial value ``black''.\newlineP
% Argument:\newlineN
% \marg{color} The color that must be used by GraphTheorySymbol
% afterward.\newlineP
% \linkToImpl{gtssetmaincolor}{0}
%
% \paragraph{\textbackslash{}GTSsetSecondColor}
% \label{macrodescgtssetsecondcolor}
%
% \DescribeMacro[noprint]{\GTSsetSecondColor}\newlineN
% This macro will set the second color used in GraphTheorySymbol.
% This color has initial value ``gray''.\newlineP
% Argument:\newlineN
% \marg{color} The color that must be used by GraphTheorySymbol
% afterward.\newlineP
% \linkToImpl{gtssetsecondcolor}{0}
%
% \subsubsection{Standard adjacency macros}
%
% \paragraph{\textbackslash{}GTS@a}
% \label{macrodescgtsaa}
%
% \DescribeMacro[noprint]{\GTS@a}\newlineN
% This macro will draw any of the adjacency symbols
% if the correct arguments are given.
% It is not expected to be used directly.\newlineP
% See the macros derived from it and \cs{GTS@b}: \cs{GTSxadjacency},
% \cs{GTSxadj}, and \cs{GTSxa}.\newlineP
% Arguments:\newlineN
% \marg{mainColor} If non-empty, this color will be used as main color.^^A
% \newlineP
% \marg{secondColor} If non-empty, this color will be used as second
% color.\newlineP
% \marg{drawSlash} Non-empty implies that a negation will be drawn.^^A
% \newlineP
% \marg{drawUpArrow} Non-empty implies that an up-arrow will be drawn.^^A
% \newlineP
% \marg{drawDownArrow} Non-empty implies that a down-arrow will be
% drawn.\newlineP
% \linkToImpl{gtsaa}{0}
%
% \paragraph{\textbackslash{}GTS@b}
% \label{macrodescgtsab}
%
% \DescribeMacro[noprint]{\GTS@b}\newlineN
% This macro builds on top of \cs{GTS@a} to handle mathematical relation
% spacing if sixth argument is not empty.
% It is not expected to be used directly.\newlineP
% See the macros derived from it and \cs{GTS@a}: \cs{GTSxadjacency},
% \cs{GTSxadj}, and \cs{GTSxa}.\newlineP
% Arguments:\newlineN
% \marg{mainColor} If non-empty, this color will be used as main color.^^A
% \newlineP
% \marg{secondColor} If non-empty, this color will be used as second
% color.\newlineP
% \marg{drawSlash} Non-empty implies that a negation will be drawn.^^A
% \newlineP
% \marg{drawUpArrow} Non-empty implies that an up-arrow will be drawn.^^A
% \newlineP
% \marg{drawDownArrow} Non-empty implies that a down-arrow will be
% drawn.\newlineP
% \marg{relation} Non-empty implies that relation spacing will be added.^^A
% \newlineP
% \linkToImpl{gtsab}{0}
%
% \paragraph{\textbackslash{}GTSxadjacency,
% \textbackslash{}GTSxadj,
% \textbackslash{}GTSxa}
% \label{macrodescgtsxa}
%
% \DescribeMacro[noprint]{\GTSxadjacency}
% \DescribeMacro[noprint]{\GTSxadj}
% \DescribeMacro[noprint]{\GTSxa}\newlineN
% Versatile macros for adjacency that can be given options.\newlineP
% Argument:\newlineN
% \oarg{optionsList} Sets the following options if not empty:\newlineN
% |mainColor=color1| or |mainC=color1| or |mColor=color1|
% or |mC=color1|,\newlineP
% |secondColor=color2| or |secondC=color2| or |sColor=color2|
% or |sC=color2|,\newlineP
% |monochrome| or |mono| or |mon| or |m|
% (equivalent to |mC=black,sC=black|),\newlineP
% |negated| or |not| or |n|,\newlineP
% |up| or |u|,\newlineP
% |down| or |d|,\newlineP
% |relation| or |rel| or |r|.\newlineP
% \linkToImpl{gtsxa}{1}
%
% \paragraph{\textbackslash{}GTSadjacency,
% \textbackslash{}GTSadj,
% \textbackslash{}GTSa}
% \label{macrodescgtsa}
%
% \DescribeMacro[noprint]{\GTSadjacency}
% \DescribeMacro[noprint]{\GTSadj}
% \DescribeMacro[noprint]{\GTSa}\newlineN
% These macros will draw an adjacency symbol.
% A first drawing didn't include the small dots in the middle of the two
% circles corresponding to the graph vertices.
% But it was too similar to `` spoon'' and multimap symbols,
% and could be confused with a graph with only two vertices and one edge.
% Hence, these dots were added and they have the nice property to remind
% of the classical textual notation of adjacency relation as Adj(.,.).^^A
% \newlineP
% \usageExampleAdjIII{GTSadjacency}{GTSadj}{GTSa}\newlineP
% \linkToImpl{gtsa}{1}
%
% \paragraph{\textbackslash{}GTSadjacencyRelation,
% \textbackslash{}GTSadjRel,
% \textbackslash{}GTSaR}
