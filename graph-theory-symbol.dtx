% {GTSnegDirAdjUpRel}{GTSnDAUR}
%
% \paragraph{\textbackslash{}GTSdirectedAdjacencyDown,
% \textbackslash{}GTSdirAdjDown,
% \textbackslash{}GTSdAD}
%
% \DescribeMacro[noprint]{\GTSdirectedAdjacencyDown}
