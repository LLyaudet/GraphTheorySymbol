%
%
% \subsection{Good practices}
%
% As is customary in algebra and logic, the conjunction/multiplication
% can be replaced by concatenation,
% and has higher priority than disjunction.
% So the following formulas are equivalent;
% we recommend using the shortest one:\newlineP
% Tournament adjacency:\newlineN
% $\forall u,v, u \mathrel{\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/} v$^^A
% \newlineP
% is prefered over\newlineP
% $\forall u,v,
% u \mathrel{\GTSdAD/\GTSmA/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSmA/\GTSdAU/}
% v$,\newlineP
% or $\forall u,v, u
% \mathrel{(\GTSdAD/\GTSmA/\GTSnDAU/)\GTSmO/(\GTSnDAD/\GTSmA/\GTSdAU/)}
% v$,\newlineP
% or even $\forall u,v,
% ((u \GTSdADR/ v) \land (u \GTSnDAUR/ v))
% \lor ((u \GTSnDADR/ v) \land (u\GTSdAUR/ v))$.\newlineP
% Note the use of macros without Relation suffix above, and adding a single
% |\mathrel{}| around the composition of all relations:\newlineP
% |\mathrel{\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/}|.\newlineP
% This is the spacing practice that we recommend,
% although for very long compositions, it may be quite unreadable,
% and then spacing everything with Relation could/should be prefered.
%
% We also recommend using brackets when the composition reflects all of the
% adjacencies between two vertices:\newlineP
% Tournament adjacency:\newlineN
% $\forall u,v,
% u \mathrel{[\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/]} v$.\newlineP
% Tournament adjacency with maybe some colored edge also, who knows?:^^A
% \newlineN
% $\forall u,v,
% u \mathrel{\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/} v$.\newlineP
% Directed graph:\newlineN
% $\forall u,v,
% u \mathrel{[\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/
% \GTSmO/\GTSdAD/\GTSdAU/\GTSmO/\GTSnDAD/\GTSnDAU/]} v$.\newlineP
% Oriented graph:\newlineN
% $\forall u,v,
% u \mathrel{[\GTSdAD/\GTSnDAU/\GTSmO/\GTSnDAD/\GTSdAU/
% \GTSmO/\GTSnDAD/\GTSnDAU/]} v$.
%
% Finally, we recommend prefix notation without ``big'' symbol for a
% sequence of consecutive ors or ands (with parentheses if needed):^^A
% \newlineP
% $\exists u,v, u
% \mathrel{[\GTSmO/\GTSxa[mC=red,d]\GTSxa[mC=green,d]\GTSxa[mC=blue,u]]}
% v$.\newlineP
% $\exists v,e, v
% \mathrel{[\GTSmO/\GTSxi[mC=red,i]\GTSxi[mC=green,i]\GTSxi[mC=blue,o]]}
% e$.
